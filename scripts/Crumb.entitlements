<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Crumb runs with the Hardened Runtime. Its only exception: sending Apple Events, which is how it asks Finder
     to move Desktop icons. No JIT, no unsigned code, no DYLD environment variables, no debugger attachment. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
